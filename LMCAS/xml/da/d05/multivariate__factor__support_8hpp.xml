        <name>factor_univariate_bridge</name>
        <qualifiedname>lamina::factor_univariate_bridge</qualifiedname>
        <param>
          <type>const Polynomial&lt; <ref refid="d8/da7/classRational" kindref="compound">Rational</ref> &gt; &amp;</type>
