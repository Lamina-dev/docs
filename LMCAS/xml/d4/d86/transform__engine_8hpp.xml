<codeline lineno="12"><highlight class="normal"></highlight><highlight class="preprocessor">#include<sp/>&quot;<ref refid="de/d80/result_8hpp" kindref="compound">result.hpp</ref>&quot;</highlight><highlight class="normal"></highlight></codeline>
<codeline lineno="13"><highlight class="normal"></highlight><highlight class="preprocessor">#include<sp/>&quot;<ref refid="d5/df2/symbolic_8hpp" kindref="compound">symbolic.hpp</ref>&quot;</highlight><highlight class="normal"></highlight></codeline>
